# ============================================================
#  OzBot — Environment Configuration Template
#  Copy this file to .env and fill in your own values.
#  NEVER share your .env file with anyone.
# ============================================================


# ── Binance ─────────────────────────────────────────────────
# Get from: https://www.binance.com/en/my/settings/api-management
# Required permissions: Futures Trading (read + trade)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# live = real money | testnet = paper trading (safe to test)
TRADING_ENV=live


# ── Strategy ────────────────────────────────────────────────
# Primary pair the bot watches for its own signals (channel signals can be any pair)
SYMBOL=BTC/USDT:USDT
TIMEFRAME=4h

# Indicators
EMA_PERIOD=50
RSI_PERIOD=14
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
ATR_TRAIL_MULTIPLIER=2.0
RSI_ENTRY_THRESHOLD=55
ADX_THRESHOLD=20
VOLUME_FILTER=true
SR_LOOKBACK=20
SR_ZONE_ATR_MULT=0.5

# MACD filter (optional extra confirmation)
MACD_FILTER=false
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Higher time-frame trend filter (blocks trades against daily trend)
HTF_FILTER=false
HTF_TIMEFRAME=1d
HTF_EMA_PERIOD=50


# ── Risk Management ─────────────────────────────────────────
FIXED_MARGIN_USD=1.0           # Fixed $1 margin per channel signal trade (traded in ISOLATED mode)
MIN_WIN_RATE=0.0               # Min historical win rate to allow a trade (0 = always trade, 0.4 = need 40%+)
RISK_PER_TRADE_PCT=0.01        # 1% of balance risked per trade (strategy signals only)
MAX_LEVERAGE=10                # Max leverage for strategy signals
DAILY_LOSS_LIMIT_PCT=0.05      # Stop trading if down 5% in a day
MAX_DRAWDOWN_PCT=0.15          # Emergency stop if down 15% from peak
MAX_CONSECUTIVE_LOSSES=3       # Auto-pause after 3 losses in a row
DRAWDOWN_ALERT_PCT=10.0        # Alert when down 10% from peak balance


# ── Multi-pair Scanner ──────────────────────────────────────
SCANNER_ENABLED=true
# Pairs to scan (comma separated, no spaces)
SCAN_PAIRS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT,BNB/USDT:USDT,DOGE/USDT:USDT,ADA/USDT:USDT,AVAX/USDT:USDT,DOT/USDT:USDT,LINK/USDT:USDT


# ── Telegram Bot ────────────────────────────────────────────
# 1. Message @BotFather on Telegram
# 2. Send /newbot — follow prompts to create your bot
# 3. Copy the token it gives you here
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID
# 1. Start your bot on Telegram
# 2. Send it any message
# 3. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 4. Find "chat":{"id": 123456789} — that number is your chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ── Telegram User API (Channel Monitoring) ──────────────────
# Lets the bot read trading signal channels automatically
# 1. Go to https://my.telegram.org
# 2. Log in with your phone number
# 3. Click "API development tools"
# 4. Create an app — copy the api_id and api_hash
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Channels to monitor for trading signals (comma separated)
# The bot will auto-execute any valid signal posted in these channels
SIGNAL_CHANNEL=https://t.me/your_signal_channel_here


# ── AI Chat (Optional) ──────────────────────────────────────
# Enables natural language chat with the bot ("what's a good trade now?")
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API key (optional, requires paid API credits)
# ANTHROPIC_API_KEY=your_anthropic_key_here
